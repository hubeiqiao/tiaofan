{
  "name": "tiaofan-source-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:data": "node scripts/prepare-demo-data.mjs && node scripts/prepare-historical-registry.mjs && node scripts/prepare-metadata-module.mjs",
    "predev": "npm run prepare:data",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare:data && node scripts/verify-compiled-css.cjs --source-only",
    "build": "vinext build",
    "postbuild": "node scripts/verify-compiled-css.cjs",
    "start": "node --import ./scripts/local-runtime.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --ip 127.0.0.1 --inspector-port 0",
    "typecheck": "npm run prepare:data && tsc --noEmit",
    "test": "npm run prepare:data && node --test tests/*.test.mjs",
    "test:smoke": "node scripts/smoke-demo.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern data",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "motion": "14.1.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.9",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.9",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261006.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.9",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.2.0",
    "vite": "8.0.16",
    "wrangler": "4.151.0"
  },
  "type": "module",
  "license": "UNLICENSED",
  "overrides": {
    "fflate": "0.7.5"
  }
}
